# Google Gemini API Key (Required for LLM extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: External Search API for fallback LinkedIn discovery (e.g., Tavily or SerpAPI)
TAVILY_API_KEY=your_tavily_api_key_here

# Crawler Settings
MAX_SUBPAGES=5
PAGE_TIMEOUT_MS=15000
MAX_TOKENS_BUDGET=7000
HEADLESS=true
